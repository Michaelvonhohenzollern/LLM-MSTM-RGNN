def match_any_pattern(text, patterns):
    for pat in patterns:
        if re.search(pat, text):
            return True, pat
    return False, ""


def classify_org(org_name):
    org = normalize_org_name(org_name)
    if org == "":
        return False, "empty", ""

    org_lower = org.lower()

    # 1. Delete Enterprises
    force_drop_hit, force_drop_rule = match_any_pattern(org_lower, FORCE_DROP_PATTERNS)
    if force_drop_hit:
        return False, "force_drop_commercial", force_drop_rule

    # 2. Research/education/medical institutions are preferred
    force_keep_hit, force_keep_rule = match_any_pattern(org_lower, FORCE_KEEP_PATTERNS)
    if force_keep_hit:
        return True, "force_keep", force_keep_rule

    # 3. Keep normal research instutions
    keep_hit, keep_rule = match_any_pattern(org_lower, KEEP_PATTERNS)
    if keep_hit:
        return True, "research_oriented", keep_rule

    # 4. Delete commercial or industrial entities
    drop_hit, drop_rule = match_any_pattern(org_lower, DROP_PATTERNS)
    if drop_hit:
        return False, "commercial_or_industrial", drop_rule

    # 5. Manually judge the unknown after this script
    if KEEP_UNKNOWN_ORGS:
        return True, "unknown_retained", ""
    else:
        return False, "unknown_removed", ""
